{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "input", "deterministic_report", "recovery", "classification", "model", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["complete", "partial"]},
    "input": {"type": "object", "minProperties": 1, "patternProperties": {"^M[0-9]{2}$": {"$ref": "#/$defs/artifact"}}, "additionalProperties": false},
    "deterministic_report": {"type": "object", "additionalProperties": false, "required": ["manifest", "status", "generation_mode"], "properties": {"manifest": {"$ref": "#/$defs/artifact"}, "status": {"enum": ["complete", "partial"]}, "generation_mode": {"const": "deterministic"}}},
    "recovery": {"type": "object", "required": ["status", "expected_sha256", "recovered", "truth"], "properties": {"status": {"const": "matched"}, "expected_sha256": {"$ref": "#/$defs/hash"}, "recovered": {"$ref": "#/$defs/artifact"}, "truth": {"$ref": "#/$defs/artifact"}}},
    "classification": {"type": "object", "required": ["evaluation", "prediction", "model"], "properties": {"evaluation": {"$ref": "#/$defs/artifact"}, "prediction": {"$ref": "#/$defs/artifact"}, "model": {"$ref": "#/$defs/artifact"}}},
    "model": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["invoked", "blocked"]}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "length": {"type": "integer", "minimum": 0}}}
  }
}
