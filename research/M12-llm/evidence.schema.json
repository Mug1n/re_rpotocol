{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.invalid/schemas/m12-evidence.schema.json",
  "title": "M12 Normalized Evidence", "type": "object", "additionalProperties": false,
  "required": ["evidence_id", "module", "source_ref", "scope", "observation", "method", "limitations"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^evidence-m[0-9]{2}-[0-9a-f]{16}$"},
    "module": {"type": "string", "pattern": "^M[0-9]{2}$"},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["module", "artifact_path", "artifact_sha256", "record_id", "schema_version"], "properties": {"module": {"pattern": "^M[0-9]{2}$"}, "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "record_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}},
    "location": {"type": "object"},
    "observation": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
