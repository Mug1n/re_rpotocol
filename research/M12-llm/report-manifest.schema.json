{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.invalid/schemas/m12-report-manifest.schema.json",
  "title": "M12 Report Manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "inputs", "generation_mode", "sections", "truncation", "warnings", "report_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"}, "status": {"enum": ["complete", "partial"]},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["module", "artifact_path", "artifact_sha256", "schema_version", "status"], "properties": {"module": {"type": "string", "pattern": "^M[0-9]{2}$"}, "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "schema_version": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}}}},
    "generation_mode": {"enum": ["deterministic", "deterministic_with_model"]},
    "sections": {"type": "object", "additionalProperties": false, "required": ["observed_facts", "interpretations", "undetermined", "recommendations"], "properties": {"observed_facts": {"$ref": "#/$defs/ids"}, "interpretations": {"$ref": "#/$defs/ids"}, "undetermined": {"$ref": "#/$defs/ids"}, "recommendations": {"$ref": "#/$defs/ids"}}},
    "truncation": {"type": "object", "additionalProperties": false, "required": ["limit", "included", "omitted"], "properties": {"limit": {"type": "integer", "minimum": 1}, "included": {"type": "integer", "minimum": 0}, "omitted": {"type": "integer", "minimum": 0}}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {"ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-m[0-9]{2}-[0-9a-f]{16}$"}}}
}
