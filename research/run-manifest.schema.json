{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/run-manifest.schema.json",
  "title": "Profile-driven Analysis Run Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "started_at", "elapsed_seconds", "input", "profile", "environment", "stages", "artifacts", "model", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"}, "run_id": {"type": "string", "minLength": 1}, "status": {"enum": ["complete", "partial"]},
    "started_at": {"type": "string", "format": "date-time"}, "elapsed_seconds": {"type": "number", "minimum": 0}, "input": {"$ref": "#/$defs/file"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "profile_id", "schema_version"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "profile_id": {"type": "string", "minLength": 1}, "schema_version": {"const": "0.1"}
    }},
    "environment": {"type": "object", "additionalProperties": false, "required": ["python", "platform", "tshark"], "properties": {
      "python": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1},
      "tshark": {"type": "object", "additionalProperties": false, "required": ["path", "available", "version"], "properties": {
        "path": {"type": ["string", "null"]}, "available": {"type": "boolean"}, "version": {"type": ["string", "null"]}
      }}
    }},
    "stages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage", "status", "elapsed_seconds", "reason"], "properties": {
      "stage": {"type": "string", "minLength": 1}, "status": {"enum": ["completed", "reused_verified", "blocked", "failed"]},
      "elapsed_seconds": {"type": "number", "minimum": 0}, "reason": {"type": ["string", "null"]}
    }}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["module", "instance_id", "path", "sha256", "length", "schema_version", "status", "scope"], "properties": {
      "module": {"type": "string", "pattern": "^(M[0-9]{2}(?:_[A-Z]+)?|PAYLOAD_SOURCES)$"}, "instance_id": {"type": "string", "minLength": 1},
      "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "length": {"type": "integer", "minimum": 0},
      "schema_version": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "scope": {"type": "object"}
    }}},
    "model": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["not_requested", "blocked", "invoked"]}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "length"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "length": {"type": "integer", "minimum": 0}
    }}
  }
}
