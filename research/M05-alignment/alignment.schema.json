{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/m05-alignment.schema.json",
  "title": "M5 AlignmentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "status", "parameters", "cluster_alignments", "unaligned_messages", "metrics", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusters_path", "clusters_sha256", "framing_path", "framing_sha256", "stream_id", "message_count"],
      "properties": {
        "clusters_path": {"type": "string", "minLength": 1},
        "clusters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "framing_path": {"type": "string", "minLength": 1},
        "framing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_id": {"type": ["string", "null"]},
        "message_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["ok", "empty"]},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "match_score", "mismatch_score", "gap_score", "max_pair_cells"],
      "properties": {
        "algorithm": {"const": "needleman_wunsch_reference"},
        "match_score": {"type": "integer"},
        "mismatch_score": {"type": "integer"},
        "gap_score": {"type": "integer", "maximum": -1},
        "max_pair_cells": {"type": "integer", "minimum": 1}
      }
    },
    "cluster_alignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/clusterAlignment"}
    },
    "unaligned_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "reason"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "reason": {"const": "m04_noise"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aligned_cluster_count", "aligned_message_count", "unaligned_message_count", "total_alignment_columns", "mean_identity_on_paired_bytes"],
      "properties": {
        "aligned_cluster_count": {"type": "integer", "minimum": 0},
        "aligned_message_count": {"type": "integer", "minimum": 0},
        "unaligned_message_count": {"type": "integer", "minimum": 0},
        "total_alignment_columns": {"type": "integer", "minimum": 0},
        "mean_identity_on_paired_bytes": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "cell": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0, "maximum": 255}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_index", "kind", "reference_offset", "insertion_anchor", "insertion_ordinal"],
      "properties": {
        "column_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["reference", "insertion"]},
        "reference_offset": {"type": ["integer", "null"], "minimum": 0},
        "insertion_anchor": {"type": "integer", "minimum": 0},
        "insertion_ordinal": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "length", "is_representative", "score", "matches", "mismatches", "gaps_in_message", "gaps_in_reference", "identity_on_paired_bytes", "cells"],
      "properties": {
        "message_id": {"type": "string", "minLength": 1},
        "length": {"type": "integer", "minimum": 0},
        "is_representative": {"type": "boolean"},
        "score": {"type": "integer"},
        "matches": {"type": "integer", "minimum": 0},
        "mismatches": {"type": "integer", "minimum": 0},
        "gaps_in_message": {"type": "integer", "minimum": 0},
        "gaps_in_reference": {"type": "integer", "minimum": 0},
        "identity_on_paired_bytes": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "clusterAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "representative_message_id", "message_count", "reference_length", "column_count", "columns", "rows"],
      "properties": {
        "cluster_id": {"type": "integer", "minimum": 0},
        "representative_message_id": {"type": "string", "minLength": 1},
        "message_count": {"type": "integer", "minimum": 1},
        "reference_length": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 0},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
      }
    }
  }
}
