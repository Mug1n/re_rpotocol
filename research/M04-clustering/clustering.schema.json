{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/m04-clustering.schema.json",
  "title": "M4 ClusteringResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "status", "parameters", "assignments", "clusters", "metrics", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing_path", "framing_sha256", "stream_id", "message_count"],
      "properties": {
        "framing_path": {"type": "string", "minLength": 1},
        "framing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_id": {"type": ["string", "null"]},
        "message_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["ok", "empty"]},
    "parameters": {"type": "object"},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "length", "cluster_id", "is_noise", "distance_to_representative"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "length": {"type": "integer", "minimum": 0},
          "cluster_id": {"type": "integer", "minimum": -1},
          "is_noise": {"type": "boolean"},
          "distance_to_representative": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id", "size", "message_ids", "representative_message_id", "mean_distance_to_representative"],
        "properties": {
          "cluster_id": {"type": "integer", "minimum": 0},
          "size": {"type": "integer", "minimum": 1},
          "message_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "representative_message_id": {"type": "string", "minLength": 1},
          "mean_distance_to_representative": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["cluster_count", "noise_count", "noise_ratio", "silhouette"],
      "properties": {
        "cluster_count": {"type": "integer", "minimum": 0},
        "noise_count": {"type": "integer", "minimum": 0},
        "noise_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "silhouette": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "adjusted_rand_index": {"type": "number", "minimum": -1, "maximum": 1},
        "normalized_mutual_information": {"type": "number", "minimum": 0, "maximum": 1},
        "nmi_normalization": {"const": "geometric_mean"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
