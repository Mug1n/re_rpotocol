{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/m07-protocols.schema.json",
  "title": "M07 Protocol Observations",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "status", "parameters", "tool", "observations", "unknown_scopes", "artifacts", "metrics", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {"$ref": "#/$defs/source"},
    "status": {"enum": ["ok", "partial", "unknown", "not_applicable", "tool_unavailable"]},
    "parameters": {"type": "object", "additionalProperties": false, "required": ["decode_as", "display_filter", "timeout_seconds", "max_capture_bytes", "max_observations", "max_tshark_output_bytes"], "properties": {"decode_as": {"type": "array", "items": {"type": "string", "minLength": 1}}, "display_filter": {"type": ["string", "null"]}, "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}, "max_capture_bytes": {"type": "integer", "minimum": 1}, "max_observations": {"type": "integer", "minimum": 1}, "max_tshark_output_bytes": {"type": "integer", "minimum": 1}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["path", "version"], "properties": {"path": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "unknown_scopes": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["observation_count", "unknown_scope_count", "processed_record_count", "truncated"], "properties": {"observation_count": {"type": "integer", "minimum": 0}, "unknown_scope_count": {"type": "integer", "minimum": 0}, "processed_record_count": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["module", "artifact_path", "artifact_sha256", "record_id", "schema_version"], "properties": {"module": {"const": "M01"}, "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "record_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}}},
    "field": {"type": "object", "additionalProperties": false, "required": ["field", "value"], "properties": {"field": {"type": "string", "minLength": 1}, "value": {"type": "string"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["observation_id", "scope_type", "scope_id", "protocol", "recognition_mode", "visibility", "field_evidence", "limitations"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "scope_type": {"enum": ["packet", "flow", "stream"]}, "scope_id": {"type": "string", "minLength": 1}, "protocol": {"enum": ["http", "smtp", "pop", "imap", "ftp", "tls", "ssh", "dns"]}, "recognition_mode": {"enum": ["dissector", "heuristic", "decode_as"]}, "visibility": {"enum": ["metadata_only", "partial_payload", "application_visible"]}, "field_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "unknown": {"type": "object", "additionalProperties": false, "required": ["scope_type", "scope_id", "reason_code"], "properties": {"scope_type": {"enum": ["input", "packet", "flow", "stream"]}, "scope_id": {"type": "string", "minLength": 1}, "reason_code": {"type": "string", "minLength": 1}}}
  }
}
