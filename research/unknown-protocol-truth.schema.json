{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent truth for held-out private-protocol evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "input_sha256", "messages"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "start", "end", "type", "fields"], "properties": {
      "id": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "type": {"type": "string", "minLength": 1},
      "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}}}
    }}}
  }
}
