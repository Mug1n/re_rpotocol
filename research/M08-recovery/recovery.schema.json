{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/m08-recovery.schema.json",
  "title": "M08 Recovery Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "status", "parameters", "recoveries", "failed_attempts", "skipped_sources", "metrics", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {"$ref": "#/$defs/source"},
    "status": {"enum": ["ok", "partial", "empty", "no_recoverable_content"]},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_bytes", "max_depth", "max_output_bytes", "max_inflation_ratio", "max_artifacts", "min_printable_length", "enabled_decoders"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 0},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_inflation_ratio": {"type": "number", "exclusiveMinimum": 0},
        "max_artifacts": {"type": "integer", "minimum": 1},
        "min_printable_length": {"type": "integer", "minimum": 1},
        "enabled_decoders": {"type": "array", "items": {"type": "string"}},
        "source_basis": {"enum": ["strict_candidate", "protocol_declared"]},
        "source_completeness": {"enum": ["complete", "partial"]}
      }
    },
    "recoveries": {"type": "array", "items": {"$ref": "#/$defs/recovery"}},
    "failed_attempts": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "skipped_sources": {"type": "array", "items": {"$ref": "#/$defs/skip"}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_count", "failed_attempt_count", "skipped_source_count", "output_bytes"],
      "properties": {
        "recovery_count": {"type": "integer", "minimum": 0},
        "failed_attempt_count": {"type": "integer", "minimum": 0},
        "skipped_source_count": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "artifact_path", "artifact_sha256", "record_id"],
      "properties": {
        "module": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "record_id": {"type": "string", "minLength": 1}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "input_length", "output_length", "parameters", "validation"],
      "properties": {
        "operation": {"enum": ["utf8", "utf16", "hex", "base64", "gzip", "zlib", "declared_plaintext_region"]},
        "input_length": {"type": "integer", "minimum": 0}, "output_length": {"type": "integer", "minimum": 0},
        "parameters": {"type": "object"}, "validation": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "sha256", "length", "media_type"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "length": {"type": "integer", "minimum": 0}, "media_type": {"type": ["string", "null"]}
      }
    },
    "sourceContext": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_sources_path", "payload_sources_sha256", "protocol", "recognition_basis", "stream_id", "flow_id", "direction", "message_index", "framing", "content_encoding"],
      "properties": {
        "payload_sources_path": {"type": "string", "minLength": 1},
        "payload_sources_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol": {"const": "http"},
        "recognition_basis": {"const": "strict_http_start_line_and_framing_headers"},
        "stream_id": {"type": "string", "minLength": 1},
        "flow_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["node0_to_node1", "node1_to_node0"]},
        "message_index": {"type": "integer", "minimum": 0},
        "framing": {"enum": ["content_length", "chunked"]},
        "content_encoding": {"type": ["string", "null"]}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_id", "source_ref", "source_range", "basis", "transformation_chain", "output", "completeness", "evidence"],
      "properties": {
        "recovery_id": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/source"},
        "source_range": {"$ref": "#/$defs/range"},
        "source_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "source_context": {"$ref": "#/$defs/sourceContext"},
        "basis": {"enum": ["protocol_declared", "validated_magic", "strict_candidate"]},
        "transformation_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "output": {"$ref": "#/$defs/output"},
        "completeness": {"enum": ["complete", "partial", "candidate"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["source_ref", "operation", "reason_code"],
      "properties": {"source_ref": {"$ref": "#/$defs/source"}, "operation": {"type": "string", "minLength": 1}, "reason_code": {"type": "string", "minLength": 1}}
    },
    "skip": {
      "type": "object", "additionalProperties": false, "required": ["source_ref", "reason_code", "detail"],
      "properties": {"source_ref": {"$ref": "#/$defs/source"}, "source_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}}, "source_context": {"$ref": "#/$defs/sourceContext"}, "reason_code": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}
    }
  }
}
